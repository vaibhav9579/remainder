## Copy this file to keystore.properties (gitignored — never commit real
## values or the keystore file itself) and fill in your own release keystore.
##
## Generate a keystore first, if you don't already have one:
##   keytool -genkeypair -v -keystore release.keystore -alias remainder \
##     -keyalg RSA -keysize 2048 -validity 10000
##
## storeFile is resolved relative to the project root.

storeFile=release.keystore
storePassword=
keyAlias=remainder
keyPassword=
